participant "طلب سحب 1" as A
database PostgreSQL as DB
participant "طلب سحب 2" as B
== قبل TM354: transaction.atomic فقط ==
A -> DB : الرصيد؟
B -> DB : الرصيد؟
DB --> A : 5$
DB --> B : 5$
A -> DB : INSERT 5$ (OK)
B -> DB : INSERT 5$ (OK)
note over A, B #FFE0E0 : الرصيد = -5$ (خرق الثابت). في الاختبار: 5 طلبات فصار الرصيد -20$
== بعد TM354: SELECT … FOR UPDATE ==
A -> DB : قفل المستخدم
B -> DB : قفل المستخدم
note right of B : ينتظر
A -> DB : الرصيد؟ 5$ ثم INSERT 5$ ثم COMMIT
DB --> B : القفل متاح
B -> DB : الرصيد؟ 0$
DB --> B : 400 الرصيد غير كافٍ
note over A, B #E0FFE0 : ينجح طلب واحد فقط، والرصيد 0
@enduml
