# انسخ هذا الملف إلى .env وضع قيماً حقيقية. لا ترفع .env إلى GitHub أبداً.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com,backend
DATABASE_PASSWORD=change-me
INTERNAL_API_KEY=change-me-another-long-random-string
# (اختياري) نطاقات مسموح لها باستدعاء الـ API من المتصفح مباشرة
CORS_ORIGINS=https://app.example.com
PASSWORD_MIN_LENGTH=8
